# ==============================================================================
# MAC-4 team IPs – thin shim kept for older MAC-4 scripts.
# Real values live in <repo>/team.env (single source of truth). Edit THAT file.
# Provides: MAC1_DNS_IP, MAC2_EDGE_IP, MAC3_BACKEND_A_IP, MAC4_MY_IP, TEAM_DOMAIN
# ==============================================================================
# Works when sourced from bash (scripts) or zsh (interactive macOS terminal)
if [ -n "$BASH_VERSION" ]; then _ti_self="${BASH_SOURCE[0]}"; else eval '_ti_self="${(%):-%x}"'; fi
source "$(cd "$(dirname "$_ti_self")/../.." && pwd)/team.env"
unset _ti_self
