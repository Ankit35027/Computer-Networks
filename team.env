# ==============================================================================
# team.env  -  SINGLE SOURCE OF TRUTH for team IPs (campus Wi-Fi DHCP)
# ------------------------------------------------------------------------------
# Every script does:  source "<repo>/team.env"
# When an IP changes (new DHCP lease):
#   1. Edit the 4 lines below
#   2. Run ./scripts/check_ips.sh  -> lists the config files that still need the new IP
# Last verified: 2026-11-23 (Stage 0 inventory)
# ==============================================================================

MAC1_IP="10.7.5.14"      # Mac 1 - Primary DNS (dnsmasq :53) + test client
MAC2_IP="10.7.31.100"    # Mac 2 - Edge nginx (TLS :8443) + load balancer
MAC3_IP="10.7.13.57"     # Mac 3 - Backend A (:3001) + backup DNS + standby edge
MAC4_IP="10.7.17.220"    # Mac 4 - Backend B (:3002) + main test client

DOMAIN="app.team1.test"
EDGE_PORT="8443"
BACKEND_A_PORT="3001"
BACKEND_B_PORT="3002"
SUBNET="10.7.0.0/19"
GATEWAY="10.7.0.1"

# ---- Aliases used by older scripts (do not edit; they follow the lines above) ----
MAC1_DNS_IP="$MAC1_IP"
MAC2_EDGE_IP="$MAC2_IP"
MAC3_BACKEND_A_IP="$MAC3_IP"
MAC4_MY_IP="$MAC4_IP"
TEAM_DOMAIN="$DOMAIN"
PRIMARY_DNS="$MAC1_IP"
BACKUP_DNS="$MAC3_IP"
PRIMARY_EDGE_IP="$MAC2_IP"
STANDBY_EDGE_IP="$MAC3_IP"
